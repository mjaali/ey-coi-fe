# Mapbox access token (client-side, safe to expose with URL restrictions)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
AUTH_AZURE_AD_AUDIENCE=
AUTH_AZURE_AD_ISSUER=https://auth.modonex.app/
AUTH_AZURE_AD_CLIENT_ID=
AUTH_AZURE_AD_CLIENT_SECRET=
AUTH_AZURE_AD_JWKS_URI=https://auth.modonex.app/.well-known/jwks.json